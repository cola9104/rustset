# 数据库配置示例
# 复制此文件为 .env 并根据你的环境修改

# ========== 方式一：使用 DATABASE_URL (推荐) ==========
# SQLite (默认，适合开发环境)
# DATABASE_URL=sqlite://data.db

# PostgreSQL (推荐用于生产环境)
# DATABASE_URL=postgres://username:password@localhost:5432/rustset

# MySQL / MariaDB
# DATABASE_URL=mysql://username:password@localhost:3306/rustset

# ========== 方式二：使用独立环境变量 ==========
# 数据库类型: sqlite, postgres, mysql
# DB_TYPE=sqlite

# SQLite 配置
# DB_PATH=data.db

# PostgreSQL / MySQL 通用配置
# DB_HOST=localhost
# DB_PORT=5432          # PostgreSQL 默认 5432，MySQL 默认 3306
# DB_NAME=rustset
# DB_USER=postgres      # PostgreSQL: postgres, MySQL: root
# DB_PASSWORD=your_secure_password

# ========== 示例配置 ==========
# 开发环境 (SQLite)
DATABASE_URL=sqlite://data.db
HOST=0.0.0.0
PORT=3003
FRONTEND_URL=http://127.0.0.1:8080,http://localhost:8080
BOOTSTRAP_DEFAULT_USERS=true
JWT_EXPIRATION_HOURS=24
SESSION_COOKIE_NAME=rustset.sid
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false
SESSION_IDLE_TIMEOUT_HOURS=24

# 生产环境 (PostgreSQL)
# DATABASE_URL=postgres://rustset:changeme@localhost:5432/rustset

# 生产环境 (MySQL)
# DATABASE_URL=mysql://rustset:changeme@localhost:3306/rustset
